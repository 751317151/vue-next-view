# Public origin used for canonical URLs, og:url, sitemap.xml and rss.xml.
#
# Nuxt loads this file during `nuxt build` on every machine and on Cloudflare
# Pages, so the value reaches both local builds and CI without dashboard
# configuration. .env.production is NOT loaded by `nuxt build`; only this file is.
#
# A production build refuses to run when this is missing, so that a silent build
# cannot bake http://localhost into crawler-facing output. Anything set in the
# Cloudflare dashboard or the shell takes precedence over this file.
NUXT_PUBLIC_SITE_URL=https://blog.blackstar.cc.cd

# Public origin used by canonical URLs, Open Graph, sitemap, and RSS generation.
VITE_SITE_URL=https://your-domain.example
NUXT_PUBLIC_SITE_URL=https://your-domain.example

# Backend endpoints.
VITE_API_BASE_URL=http://localhost:8081
VITE_WEB_URL=http://localhost
NUXT_PUBLIC_API_BASE=/api

# Keep mock data enabled only for local prototyping.
VITE_USE_MOCK=true

{
  "name": "vue-next-view",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "dev:vite": "vite",
    "dev:nuxt": "nuxt dev",
    "build": "node scripts/pages-build.mjs",
    "build:vite": "vite build",
    "build:with-seo": "npm run generate:seo && vite build && node scripts/copy-seo-to-dist.mjs && npm run validate:seo",
    "build:nuxt": "nuxt build",
    "preview": "vite preview",
    "preview:nuxt": "nuxt preview",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:nuxt": "nuxt prepare && vue-tsc --noEmit -p .nuxt/tsconfig.app.json && vue-tsc --noEmit -p .nuxt/tsconfig.server.json",
    "validate:nuxt": "node scripts/validate-nuxt-scaffold.mjs",
    "validate:pages": "node scripts/validate-pages-build.mjs",
    "validate:seo": "node scripts/validate-public-seo.mjs",
    "validate:env": "node scripts/validate-env.mjs",
    "generate:seo": "node scripts/generate-seo.mjs",
    "check:static": "npm run validate:nuxt && npm run validate:pages && npm run validate:env && npm run typecheck && npm run typecheck:nuxt",
    "release:check": "npm run check:static && npm run build:cf && npm run validate:seo",
    "build:cf": "node scripts/clean-build-output.mjs dist .output && cross-env NITRO_PRESET=cloudflare_pages nuxt build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.1.0",
    "@kangc/v-md-editor": "^2.3.18",
    "@types/nprogress": "^0.2.3",
    "animejs": "^3.2.1",
    "aos": "^2.3.4",
    "crypto-js": "^4.1.1",
    "element-plus": "^2.3.7",
    "highlight.js": "^11.11.1",
    "jquery": "^3.7.0",
    "nprogress": "^0.2.0",
    "path": "^0.12.7",
    "pinia": "^2.1.4",
    "pinia-plugin-persistedstate": "^3.1.0",
    "tocbot": "^4.21.2",
    "vue": "^3.2.47",
    "vue-router": "^4.2.2",
    "vue-seamless-scroll": "^1.1.23",
    "vue3-danmaku": "^1.5.1",
    "vue3-seamless-scroll": "^2.0.1",
    "vue3-social-share": "^0.1.7"
  },
  "devDependencies": {
    "@rollup/plugin-inject": "^5.0.3",
    "@types/animejs": "^3.1.7",
    "@types/jquery": "^3.5.16",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^4.1.0",
    "cross-env": "^10.1.0",
    "fast-glob": "^3.3.0",
    "nuxt": "^4.1.3",
    "sass": "^1.63.6",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^0.16.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^4.3.9",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue-tsc": "^2.2.12",
    "wrangler": "^4.165.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  }
}
